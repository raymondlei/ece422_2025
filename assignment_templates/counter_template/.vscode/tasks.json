{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-I${workspaceFolder}\\counter",
                "-I${workspaceFolder}\\unit_test",
                "-g",
                "${workspaceFolder}\\*.c",
                "${workspaceFolder}\\counter\\*.c",
                "${workspaceFolder}\\counter\\*.h",
                "${workspaceFolder}\\unit_test\\*.c",
                "${workspaceFolder}\\unit_test\\*.h",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
    ],
    "version": "2.0.0"
}